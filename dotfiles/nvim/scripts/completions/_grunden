#compdef grunden
# zsh completion for the grunden CLI (../grunden). Loaded via fpath in .zshrc.

_grunden_voices() {
    local -a voices=(
        Abigail Adrian Alexander Alice Austin Axel Connor Cora Elena Eli Emily
        Everett Gabriel Gianna Henry Ian Jade Jeremiah Jordan Julian Layla
        Leonardo Michael Miles Olivia Ryan Taylor Thomas
    )
    _describe -t voices 'voice' "(${voices[*]/%/.wav})"
}

_grunden() {
    local -a commands=(
        'models:Chat model catalog (price, context, best use) + other models'
        'ask:One-shot chat (-M gemma|flash|deepseek|glm, default flash, lowest effort); stdin appended'
        'embed:Embeddings with bge-m3 (1024-dim); stdin = one text per line'
        'rerank:Rank docs against a query (args or stdin lines) with bge-reranker'
        'pii:Detect and mask Swedish PII (names, phone numbers, personnummer)'
        'transcribe:Speech to text (kb-whisper-large, pianissimo-sv/-da), max 50 MB'
        'tts:Text to speech with chatterbox; requires -o OUT'
        'claude:Start an interactive Claude Code session on a Grunden chat model'
        'balance:Account balance'
        'usage:Cost for this API key per dimension/model (default this month; -a = whole org)'
        'help:Show usage'
    )

    if (( CURRENT == 2 )); then
        _describe -t commands 'grunden command' commands
        return
    fi

    local cmd=${words[2]}
    curcontext="${curcontext%:*:*}:grunden-$cmd:"
    case $cmd in
    ask)
        _arguments -s \
            '(-M --model)'{-M,--model}'[chat model]:model:((gemma\:"cheapest+fastest, 31k ctx, short one-shot jobs" flash\:"cheap all-rounder, 1M ctx (default)" deepseek\:"Grunden default, image input" glm\:"big GLM, hardest tasks, most expensive"))' \
            '(-e --effort)'{-e,--effort}'[reasoning effort]:effort:((none\:"gemma only: thinking off (gemma default)" low\:"fast and cheap (default)" high\:"deeper" max\:"deepest, slowest"))' \
            '(-s --system)'{-s,--system}'[system prompt]:system prompt: ' \
            '(-m --max-tokens)'{-m,--max-tokens}'[max output tokens (default 4096)]:tokens:(512 1024 2048 4096 8192)' \
            '(-j --json)'{-j,--json}'[print raw JSON incl. token usage]' \
            '*:prompt (or pipe text via stdin): '
        ;;
    transcribe)
        _arguments \
            '(-m --model)'{-m,--model}'[STT engine]:model:((kb-whisper-large\:"KB-Whisper Large (default)" pianissimo-sv\:"Pianissimo Swedish" pianissimo-da\:"Pianissimo Danish"))' \
            '1:audio file:_files -g "*.(wav|mp3|m4a|ogg|opus|flac|webm|mp4)(-.)"'
        ;;
    tts)
        _arguments \
            '(-o --out)'{-o,--out}'[output file (format from extension)]:output file:_files -g "*.(wav|mp3|opus)(-.)"' \
            '(-v --voice)'{-v,--voice}'[voice (default Alice.wav)]:voice:_grunden_voices' \
            '(-f --format)'{-f,--format}'[audio format]:format:(wav mp3 opus)' \
            '(-l --language)'{-l,--language}'[language code]:language:(sv en da no fi de fr es)' \
            '*:text (or pipe via stdin): '
        ;;
    rerank)
        _arguments '1:query: ' '*:document (or pipe one per line via stdin): '
        ;;
    claude)
        # First bare word = model (matches grunden's arg loop); the rest are
        # passed through to claude itself.
        if (( CURRENT == 3 )); then
            local -a models=(
                'glm:big GLM, hardest tasks (default)'
                'deepseek:Grunden default, image input'
                'flash:cheap all-rounder, subagent model'
            )
            _describe -t claude-models 'chat model' models
        else
            _arguments \
                '(-M --model)'{-M,--model}'[chat model]:model:((glm\:"big GLM, hardest tasks (default)" deepseek\:"Grunden default, image input" flash\:"cheap all-rounder, subagent model"))' \
                '*:claude args: '
        fi
        ;;
    usage)
        _arguments \
            '(-f --from)'{-f,--from}'[start date, inclusive (default: 1st of this month)]:date (YYYY-MM-DD): ' \
            '(-t --to)'{-t,--to}'[end date, exclusive (default: 1st of next month)]:date (YYYY-MM-DD): ' \
            '(-b --by)'{-b,--by}'[group by]:groups:_values -s , group api_key end_user model' \
            '(-a --all)'{-a,--all}'[whole organisation, not just this API key]' \
            '(-j --json)'{-j,--json}'[raw JSON]'
        ;;
    embed|pii)
        _arguments '*:text (or - / pipe via stdin): '
        ;;
    models)
        _arguments '(--agentic)--chat[chat model ids, tab-separated]' '(--chat)--agentic[ids usable in Claude Code]'
        ;;
    *)
        _message 'no arguments'
        ;;
    esac
}

_grunden "$@"
