#!/usr/bin/env bash
# grunden — tiny CLI over the Grunden API (https://api.grunden.ai).
# Credentials come from ~/.grunden.env (GRUNDEN_API_KEY, GRUNDEN_API_URL).
# Used by Claude Code sessions launched via <leader>ao to offload work to
# cheaper/specialised Grunden models. Run `grunden help` for usage.
set -euo pipefail

ENV_FILE="${GRUNDEN_ENV_FILE:-$HOME/.grunden.env}"
if [[ -z "${GRUNDEN_API_KEY:-}" && -r "$ENV_FILE" ]]; then
    set -a; . "$ENV_FILE"; set +a
fi
: "${GRUNDEN_API_KEY:?GRUNDEN_API_KEY missing (set it in $ENV_FILE)}"
BASE="${GRUNDEN_API_URL:-https://api.grunden.ai}"; BASE="${BASE%/}"
# Default model for `grunden ask` (id or alias from the catalog below).
CHAT_MODEL="${GRUNDEN_CHAT_MODEL:-flash}"

# Chat model catalog. /v1/models only lists deepseek, but these all work with
# our key (verified 2026-11-20). Prices are € per 1M tokens excl. VAT; the
# unlisted ones were measured from usage deltas (marked ~). Context: gemma
# rejects >31129 tokens; GLM accepted 600k. "agentic" = works as a Claude
# Code model (tool calling via /v1/messages) — this is what <leader>ao offers.
# Gemma technically runs in Claude Code with a capped context/output, but
# 31k is too small to be useful there, so it's delegation-only.
# id|alias|in|out|context|reasoning levels|default effort|agentic|best for
CATALOG='gemma-4-26b|gemma|~0.12|~0.36|31k|none/high|none|no|Cheapest+fastest. Short one-shot text jobs: classify, extract, translate, short summaries. Too small (31k) for Claude Code sessions.
glm-5.3-flash|flash|~0.16|~0.48|1M|low/high/max|low|yes|Cheap all-rounder, long context. Default for delegated jobs and Claude Code subagents.
deepseek-v4.1-flash-1017|deepseek|0.50|1.50|1M|low/high/max|low|yes|Grunden default (listed) chat model. Image input on /v1/chat/completions.
glm-5.3|glm|~0.72|~1.44|1M|low/high/max|low|yes|Big GLM, most used across the organisation. Hard coding/agentic work, tricky reasoning. Most expensive.'

# resolve_model ALIAS_OR_ID -> catalog line (or a synthetic one for unknown ids)
resolve_model() {
    local line
    line=$(printf '%s\n' "$CATALOG" | awk -F'|' -v m="$1" '$1 == m || $2 == m' | head -1)
    [[ -n "$line" ]] && printf '%s' "$line" || printf '%s|%s|?|?|?|?|low|?|' "$1" "$1"
}
# Optional cost dimension (`user` field); unset = "Not dimensioned".
TAG="${GRUNDEN_USER_TAG:-}"

die() { echo "grunden: $*" >&2; exit 1; }

# Read text from remaining args, or stdin when no args / "-".
text_arg() {
    if [[ $# -eq 0 || "$1" == "-" ]]; then cat; else printf '%s' "$*"; fi
}

api() { # api METHOD PATH [curl args...]
    local method=$1 path=$2; shift 2
    local out code
    out=$(curl -sS --max-time "${GRUNDEN_TIMEOUT:-300}" -X "$method" \
        -H "Authorization: Bearer $GRUNDEN_API_KEY" -w $'\n%{http_code}' \
        "$@" "$BASE$path") || die "request failed: $path"
    code=${out##*$'\n'}; out=${out%$'\n'*}
    [[ "$code" == 2* ]] || die "HTTP $code from $path: $out"
    printf '%s' "$out"
}

json_post() { api POST "$1" -H "Content-Type: application/json" --data-binary @-; }

usage() {
    cat <<'EOF'
grunden <command> [options]

  models [--chat|--agentic]      Chat model catalog (price, context, best use) + other models.
                                 --chat / --agentic: just the ids (agentic = usable in Claude Code)
  ask [opts] [PROMPT|-]          One-shot chat completion, prints the answer.
      -M, --model MODEL          gemma | flash (default) | deepseek | glm, or a full id
      -e, --effort LEVEL         Reasoning effort (default: lowest — none for gemma, low otherwise)
      -s, --system TEXT          System prompt
      -m, --max-tokens N         Max output tokens (default 4096)
      -j, --json                 Print raw JSON response (incl. usage)
      PROMPT may be given as args or via stdin; with both, stdin is
      appended after the args (handy: `cat file | grunden ask "Summarise:"`).
  embed [TEXT|-]                 Embedding (bge-m3, 1024-dim). Stdin: one text per line.
                                 Prints JSON array of vectors.
  rerank QUERY [DOC...]          Rerank docs against QUERY (docs from args or
                                 stdin, one per line). Prints "score<TAB>index<TAB>doc".
  pii [TEXT|-]                   Detect + mask Swedish PII. Prints JSON.
  transcribe FILE [-m MODEL]     Speech→text (kb-whisper-large default;
                                 pianissimo-sv / pianissimo-da). Max 50 MB.
  tts [TEXT|-] -o OUT [-v VOICE] [-f wav|mp3|opus] [-l LANG]
                                 Text→speech (chatterbox). Default voice Alice.wav.
  balance                        Account balance
  usage [opts]                   Cost per API key / dimension / model (default: this month)
      -f, --from DATE            Start, inclusive (YYYY-MM-DD or ISO-8601)
      -t, --to DATE              End, exclusive
      -b, --by GROUPS            api_key,end_user,model (default end_user,model)
      -a, --all                  Whole organisation, not just this API key
      -j, --json                 Raw JSON
EOF
}

cmd=${1:-help}; shift || true
case "$cmd" in
models)
    # Machine-readable: id<TAB>alias<TAB>in→out<TAB>context<TAB>best for (used by <leader>ao).
    case "${1:-}" in
    --chat) printf '%s\n' "$CATALOG" | awk -F'|' '{print $1"\t"$2"\t"$3"→"$4"\t"$5"\t"$9}'; exit 0 ;;
    --agentic) printf '%s\n' "$CATALOG" | awk -F'|' '$8 == "yes" {print $1"\t"$2"\t"$3"→"$4"\t"$5"\t"$9}'; exit 0 ;;
    esac
    echo "CHAT MODELS (cheapest first; € per 1M tokens excl. VAT, ~ = measured, not listed by the API)"
    { echo "ALIAS|ID|IN→OUT|CONTEXT|EFFORT|CLAUDE CODE|BEST FOR"
      printf '%s\n' "$CATALOG" | awk -F'|' '{printf "%s|%s|%s→%s|%s|%s|%s|%s\n", $2, $1, $3, $4, $5, $6, $8, $9}'
    } | column -t -s '|'
    echo
    echo "OTHER MODELS (from /v1/models)"
    api GET /v1/models | jq -r '.data[] | select(.type != "chat") | [.id, .type, .endpoint] | @tsv' \
        | column -t -s $'\t'
    ;;
ask)
    effort="" system="" max_tokens=4096 raw=0 args=() model=$CHAT_MODEL
    while [[ $# -gt 0 ]]; do
        case "$1" in
        -M|--model) model=$2; shift 2 ;;
        -e|--effort) effort=$2; shift 2 ;;
        -s|--system) system=$2; shift 2 ;;
        -m|--max-tokens) max_tokens=$2; shift 2 ;;
        -j|--json) raw=1; shift ;;
        --) shift; args+=("$@"); break ;;
        *) args+=("$1"); shift ;;
        esac
    done
    prompt="${args[*]:-}"
    if [[ -p /dev/stdin || -f /dev/stdin ]]; then
        stdin=$(cat)
        [[ -n "$stdin" ]] && prompt="${prompt:+$prompt

}$stdin"
    fi
    [[ -n "$prompt" ]] || die "ask: empty prompt"
    explicit_effort=$effort
    send() { # send MODEL_ID EFFORT
        jq -n --arg m "$1" --arg e "$2" --arg s "$system" \
            --arg p "$prompt" --argjson n "$max_tokens" --arg u "$TAG" '{
                model: $m, reasoning_effort: $e, max_tokens: $n,
                messages: ((if $s != "" then [{role:"system",content:$s}] else [] end)
                           + [{role:"user",content:$p}])
            } + (if $u != "" then {user: $u} else {} end)' | json_post /v1/chat/completions
    }
    IFS='|' read -r id _ _ _ _ _ def_effort _ _ <<<"$(resolve_model "$model")"
    errf=$(mktemp); trap 'rm -f "$errf"' EXIT
    if ! resp=$(send "$id" "${explicit_effort:-$def_effort}" 2>"$errf"); then
        # Gemma's 31k context is easy to overflow with piped files: retry on flash.
        if grep -q "prompt is too long" "$errf" && [[ "$id" != glm-5.3-flash ]]; then
            echo "grunden: prompt too long for $id, retrying on glm-5.3-flash" >&2
            IFS='|' read -r id _ _ _ _ _ def_effort _ _ <<<"$(resolve_model flash)"
            resp=$(send "$id" "${explicit_effort:-$def_effort}")
        else
            cat "$errf" >&2; exit 1
        fi
    fi
    if [[ $raw -eq 1 ]]; then printf '%s\n' "$resp"
    else printf '%s\n' "$resp" | jq -r '.choices[0].message.content // empty'
    fi
    ;;
embed)
    if [[ $# -gt 0 && "$1" != "-" ]]; then input=$(jq -n --arg t "$*" '$t')
    else input=$(jq -R . | jq -s .)
    fi
    jq -n --argjson i "$input" '{model:"bge-m3", input:$i}' | json_post /v1/embeddings \
        | jq -c '[.data[].embedding]'
    ;;
rerank)
    [[ $# -ge 1 ]] || die "rerank: QUERY required"
    query=$1; shift
    if [[ $# -gt 0 ]]; then docs=$(printf '%s\n' "$@" | jq -R . | jq -s .)
    else docs=$(jq -R . | jq -s .)
    fi
    resp=$(jq -n --arg q "$query" --argjson t "$docs" '{query:$q, texts:$t}' | json_post /v1/rerank)
    # Response shape varies between engines; normalise to score/index.
    printf '%s' "$resp" | jq -r --argjson t "$docs" '
        (if type == "array" then . else (.results // .data // []) end)
        | sort_by(-(.score // .relevance_score // 0))[]
        | (.index) as $i | [(.score // .relevance_score), $i, $t[$i]] | @tsv'
    ;;
pii)
    text=$(text_arg "$@")
    jq -n --arg t "$text" '{text:$t}' | json_post /v1/pii/redact | jq .
    ;;
transcribe)
    [[ $# -ge 1 ]] || die "transcribe: FILE required"
    file=$1; shift; model=""
    [[ "${1:-}" == "-m" || "${1:-}" == "--model" ]] && model=$2
    [[ -r "$file" ]] || die "cannot read $file"
    api POST /v1/audio/transcriptions -F "file=@$file" ${model:+--form-string "model=$model"} \
        | jq -r '.text // .'
    ;;
tts)
    out="" voice="Alice.wav" fmt="" lang="" args=()
    while [[ $# -gt 0 ]]; do
        case "$1" in
        -o|--out) out=$2; shift 2 ;;
        -v|--voice) voice=$2; shift 2 ;;
        -f|--format) fmt=$2; shift 2 ;;
        -l|--language) lang=$2; shift 2 ;;
        *) args+=("$1"); shift ;;
        esac
    done
    [[ -n "$out" ]] || die "tts: -o OUT required"
    text=$(text_arg "${args[@]:-}")
    fmt=${fmt:-${out##*.}}
    jq -n --arg t "$text" --arg v "$voice" --arg f "$fmt" --arg l "$lang" \
        '{model:"chatterbox", input:$t, voice:$v, response_format:$f} + (if $l != "" then {language:$l} else {} end)' \
        | curl -sS --fail-with-body --max-time 300 -H "Authorization: Bearer $GRUNDEN_API_KEY" \
            -H "Content-Type: application/json" --data-binary @- -o "$out" "$BASE/v1/audio/speech" \
        || die "tts failed"
    echo "$out"
    ;;
balance) api GET /v1/balance | jq . ;;
usage)
    # Dates: YYYY-MM-DD (local midnight) or full ISO-8601. Default: this month.
    tz=$(date +%z); tz="${tz:0:3}:${tz:3:2}"
    iso() { [[ "$1" == *T* ]] && printf '%s' "$1" || printf '%sT00:00:00%s' "$1" "$tz"; }
    from=$(date +%Y-%m-01)
    to=$(date -v1d -v+1m +%Y-%m-01 2>/dev/null || date -d "$(date +%Y-%m-01) +1 month" +%Y-%m-01)
    by="end_user,model" raw=0 all=0
    while [[ $# -gt 0 ]]; do
        case "$1" in
        -f|--from) from=$2; shift 2 ;;
        -t|--to) to=$2; shift 2 ;;
        -b|--by) by=$2; shift 2 ;;
        -j|--json) raw=1; shift ;;
        -a|--all) all=1; shift ;;
        *) die "usage: unknown option $1" ;;
        esac
    done
    # The API reports the whole org; by default keep only rows for our own
    # key, matched on api_key_prefix (the key's first 16 chars).
    qby=$by
    if [[ $all -eq 0 && ",$by," != *,api_key,* ]]; then qby="api_key,$by"; fi
    resp=$(api GET /v1/usage/allocation -G --data-urlencode "from=$(iso "$from")" \
        --data-urlencode "to=$(iso "$to")" --data-urlencode "group_by=$qby")
    if [[ $all -eq 0 ]]; then
        resp=$(printf '%s' "$resp" | jq --arg k "$GRUNDEN_API_KEY" \
            '.data |= map(.api_key_prefix as $p | select($p != null and ($k | startswith($p))))')
    fi
    if [[ $raw -eq 1 ]]; then printf '%s\n' "$resp"; exit 0; fi
    scope="all keys"
    [[ $all -eq 0 ]] && scope="key $(printf '%s' "$resp" | jq -r '.data[0].api_key_name // "(no usage yet)"')"
    echo "Usage for $scope, $from → $to (to exclusive), grouped by $by"
    printf '%s' "$resp" | jq -r '
        # 2 decimals, or 4 below one cent so tiny delegated calls are visible.
        def eur: (if . >= 1e7 then 2 else 4 end) as $d
            | (. / 1e9 * pow(10; $d) | round / pow(10; $d) | tostring) as $s
            | ($s | split(".")) as $p
            | "€" + $p[0] + "." + (($p[1] // "") + "0000")[0:$d];
        (["KEY", "DIMENSION", "MODEL", "REQUESTS", "TOKENS", "EXCL. VAT", "INCL. VAT"] | @tsv),
        (.data | sort_by(-.cost_gross_nanoeur)[] | [
            (.api_key_name // "-"), (.end_user_ref // "Not dimensioned"), (.model_id // "-"),
            .requests, .total_tokens, (.cost_net_nanoeur | eur), (.cost_gross_nanoeur | eur)
        ] | @tsv),
        (["TOTAL", "-", "-", (.data | map(.requests) | add // 0), (.data | map(.total_tokens) | add // 0),
          (.data | map(.cost_net_nanoeur) | add // 0 | eur), (.data | map(.cost_gross_nanoeur) | add // 0 | eur)] | @tsv)
    ' | column -t -s $'\t'
    ;;
help|-h|--help) usage ;;
*) usage >&2; exit 2 ;;
esac
